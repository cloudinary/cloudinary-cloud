{
  "name": "@cloudinary/cloud",
  "version": "0.1.0",
  "description": "One command to get a disposable Cloudinary cloud account — no signup required",
  "type": "module",
  "bin": {
    "cloudinary-cloud": "./dist/index.js"
  },
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "default": "./dist/lib/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cloudinary/cloudinary-cloud.git"
  },
  "bugs": {
    "url": "https://github.com/cloudinary/cloudinary-cloud/issues"
  },
  "homepage": "https://github.com/cloudinary/cloudinary-cloud#readme",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "npm run build && node --test",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "cloudinary",
    "cloud",
    "ai",
    "agent",
    "cli"
  ],
  "author": "Cloudinary",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
